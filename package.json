  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "zod": "^4.4.3"
  },
  "prisma": {
